{
	"name": "rememento",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"cf-typegen": "wrangler types",
		"check:fast": "tsc --noEmit && biome check . && bash scripts/scan-secrets.sh",
		"check:task": "npm run check:fast && vitest run --coverage && node scripts/diff-coverage.mjs && node scripts/osv-high.mjs && depcruise --validate .dependency-cruiser.cjs src && bash scripts/floor-guard.sh",
		"check:full": "npm run check:task && wrangler deploy --dry-run --outdir .wrangler/dry-run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@cloudflare/vitest-plugin": "1.3.4",
		"@vitest/coverage-istanbul": "4.1.11",
		"dependency-cruiser": "18.4.0",
		"typescript": "5.9.3",
		"vitest": "4.1.11",
		"wrangler": "4.145.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260930.2": true
	},
	"dependencies": {
		"zod": "4.6.5"
	}
}
